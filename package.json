{
  "name": "jev-review",
  "version": "0.1.0",
  "description": "A small staged code-review workflow built with TypeSafe Jev.",
  "private": true,
  "license": "MIT",
  "repository": "github:devagrawal09/jev-review",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "review:changes": "node --env-file=.env src/cli/review-changes.ts",
    "review:changes:save": "node --env-file=.env src/cli/save-changes.ts",
    "review:codebase": "node --env-file=.env src/cli/review-codebase.ts",
    "review:codebase:save": "node --env-file=.env src/cli/save-codebase.ts",
    "dashboard": "node src/dashboard/server.ts",
    "test": "node --test src/adapters/judgment.test.ts scripts/report.test.ts",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-dependencies.ts",
    "check": "npm run typecheck && npm run check:deps && node --check src/dashboard/public/app.js"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.105"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
